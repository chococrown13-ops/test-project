{
  "name": "football-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "sim": "esbuild tools/simulate.ts --bundle --platform=node --format=esm --outfile=.tmp/sim.mjs --log-level=warning && node .tmp/sim.mjs",
    "clubcheck": "esbuild tools/clubcheck.ts --bundle --platform=node --format=esm --outfile=.tmp/clubcheck.mjs --log-level=warning && node .tmp/clubcheck.mjs",
    "tiercheck": "esbuild tools/tiercheck.ts --bundle --platform=node --format=esm --outfile=.tmp/tiercheck.mjs --log-level=warning && node .tmp/tiercheck.mjs",
    "loancheck": "esbuild tools/loancheck.ts --bundle --platform=node --format=esm --outfile=.tmp/loancheck.mjs --log-level=warning && node .tmp/loancheck.mjs",
    "revealcheck": "esbuild tools/revealcheck.ts --bundle --platform=node --format=esm --outfile=.tmp/revealcheck.mjs --log-level=warning && node .tmp/revealcheck.mjs",
    "play": "esbuild tools/playthrough.ts --bundle --platform=node --format=esm --outfile=.tmp/play.mjs --log-level=warning && node .tmp/play.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
