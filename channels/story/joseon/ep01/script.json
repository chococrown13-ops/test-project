 "lines": [
  {
   "who": "민재",
   "text": "9시 58분… 마지막 배달, 종각역 2번 출구. 됐다!",
   "mood": "normal",
   "pause": 0.6,
   "acts": [
    {
     "act": "city2026",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "어? 보신각 종은 제야에만 치는 거 아닌가?",
   "mood": "cry",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ],
   "acts": [
    {
     "act": "flash",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "…여기 원래 종각역인데. 역이… 어디 갔지?",
   "mood": "normal",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ],
   "acts": [
    {
     "act": "city1795",
     "at": -0.5
    }
   ]
  },
  {
   "who": "댕이",
   "text": "띠링! 접속 완료. 어서 오세요, 플레이어 민재 님!",
   "mood": "normal",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "magic",
     "at": -0.5
    }
   ],
   "acts": [
    {
     "act": "daengi_spawn",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "으악! 뭐야, 날아다니는 종?!",
   "mood": "surprised"
  },
  {
   "who": "댕이",
   "text": "종 아니고 댕이예요. 종소리에서 태어난 안내 정령이죠.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "지금부터 제가 이 세계의 가이드를 맡을게요.",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "퀘스트? 제한 시간이 종 28번?",
   "mood": "normal",
   "card": "c1"
  },
  {
   "who": "댕이",
   "text": "방금 그게 몇 번째였을까요? 저도 안 셌어요. 헤헤.",
   "mood": "normal",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ],
   "card": "c1"
  },
  {
   "who": "민재",
   "text": "안 세면 어떡해! 다 울리면 어떻게 되는데?",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "길에 있으면… 잡혀가요. 진짜로요.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "여긴 1795년, 정조 19년 한양이에요. 환영해요!",
   "mood": "normal",
   "card": "c2"
  },
  {
   "who": "민재",
   "text": "지도 앱도 안 되고, 배터리는 12퍼센트.",
   "mood": "normal",
   "pause": 0.6,
   "acts": [
    {
     "act": "phone",
     "at": -0.5
    }
   ]
  },
  {
   "who": "댕이",
   "text": "걱정 마세요. 제가 지도 기능도 있거든요.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "지금 서 계신 곳이 종루 앞이에요.",
   "mood": "cry",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ],
   "acts": [
    {
     "act": "map_open",
     "at": -0.5
    }
   ]
  },
  {
   "who": "댕이",
   "text": "오늘날 종로와 남대문로가 만나는 네거리, 보신각 근처죠.",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "오, 길은 똑같네. 그럼 나 여기 지리는 만렙이다.",
   "mood": "normal",
   "card": "c3"
  },
  {
   "who": "댕이",
   "text": "길은 같아도 규칙이 달라요. 그게 문제죠.",
   "mood": "normal",
   "card": "c3"
  },
  {
   "who": "민재",
   "text": "그래서 이 종은 뭔데?",
   "mood": "normal",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ]
  },
  {
   "who": "댕이",
   "text": "이 종 이름은 '인정'이에요. 매일 밤 10시쯤, 스물여덟 번 쳐요.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "다 치면 성문을 닫고, 길을 다니는 게 금지돼요.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "새벽 4시쯤엔 서른세 번 쳐서 풀어 줘요. 그건 '파루'.",
   "mood": "normal",
   "card": "c4"
  },
  {
   "who": "댕이",
   "text": "1395년 도성을 쌓을 때부터,",
   "mood": "normal",
   "card": "c5"
  },
  {
   "who": "댕이",
   "text": "성문 여덟 개가 이 종소리에 맞춰 여닫혔어요.",
   "mood": "normal",
   "card": "c5"
  },
  {
   "who": "민재",
   "text": "밤 10시부터 새벽 4시까지 밖에 못 나간다고?",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "우리 때 편의점 야간 알바 시간인데.",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "됐고, 그냥 집에 갈래. 우리 집 마포니까 걸어서 한 시간.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "띠링! 경고. 마포는 성 밖이에요.",
   "mood": "normal",
   "pause": 0.6,
   "acts": [
    {
     "act": "map_wall",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "…어? 진짜네?",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "한양은 성곽으로 둘러싸인 도시예요. 문은 동서남북에 하나씩 큰 문.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "동쪽 흥인지문, 서쪽 돈의문, 남쪽 숭례문, 북쪽 숙정문.",
   "mood": "normal"
  },
  {
   "who": "댕이",
   "text": "인정 종이 다 울리면 이 문들이 전부 닫혀요.",
   "mood": "normal",
   "card": "c6"
  },
  {
   "who": "댕이",
   "text": "오늘은 성 밖으로 못 나가요.",
   "mood": "normal",
   "card": "c6"
  },
  {
   "who": "민재",
   "text": "여기 원래 버스 타면 15분 거리인데!",
   "mood": "normal",
   "jump": true,
   "pause": 0.6,
   "acts": [
    {
     "act": "gate_close",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "근데 걸리면 뭐, 벌금 정도겠지?",
