   "pause": 0.6,
   "acts": [
    {
     "act": "show_card",
     "at": -0.5
    }
   ]
  },
  {
   "who": "댕이",
   "text": "그건 어제 국밥값으로도 안 받아 줬잖아요.",
   "mood": "normal"
