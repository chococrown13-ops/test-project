 "lines": [
  {
   "who": "민재",
   "text": "9시 58분… 마지막 배달, 종각역 2번 출구. 됐다!",
   "mood": "normal",
   "pause": 0.6,
   "acts": [
    {
     "act": "city2026",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "어? 보신각 종은 제야에만 치는 거 아닌가?",
   "mood": "cry",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ],
   "acts": [
    {
     "act": "flash",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "…여기 원래 종각역인데. 역이… 어디 갔지?",
   "mood": "normal",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ],
   "acts": [
    {
     "act": "city1795",
     "at": -0.5
    }
   ]
  },
  {
   "who": "돌쇠",
   "text": "아저씨, 비켜요! 곧 인정이에요!",
   "mood": "normal",
   "jump": true,
   "pause": 0.6
  },
  {
   "who": "민재",
   "text": "인정? 인정이 뭔데?",
   "mood": "normal"
  },
  {
   "who": "해설",
   "text": "지금 울리는 종은, 스물여덟 번을 다 치면 문이 닫히는 종입니다.",
   "mood": "normal",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ]
  },
  {
   "who": "해설",
   "text": "그리고 그 뒤에 길에 있는 사람은… 잡혀갑니다.",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "잡혀간다고? 나 아무 짓도 안 했는데?",
   "mood": "normal",
   "card": "c1"
  },
  {
   "who": "해설",
   "text": "1795년, 정조 19년. 한양의 밤이 시작됩니다.",
   "mood": "normal",
   "card": "c2"
  },
  {
   "who": "민재",
   "text": "지도 앱도 안 되고, 배터리는 12퍼센트.",
   "mood": "normal",
   "pause": 0.6,
   "acts": [
    {
     "act": "phone",
     "at": -0.5
    }
   ]
  },
  {
   "who": "민재",
   "text": "좋아, 침착하자. 난 서울 골목은 다 안다.",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "여기가 종로 네거리면… 저기 큰 누각이 보신각 자리겠지.",
   "mood": "normal"
  },
  {
   "who": "해설",
   "text": "민재의 짐작이 맞습니다.",
   "mood": "normal"
  },
  {
   "who": "해설",
   "text": "조선의 종루는 오늘날 종로와 남대문로가 만나는 네거리에 있었습니다.",
   "mood": "normal"
  },
  {
   "who": "해설",
   "text": "서울 한복판에서 종을 쳐서, 도성 사람 모두에게 시각을 알렸지요.",
   "mood": "normal",
   "card": "c3"
  },
  {
   "who": "민재",
   "text": "몇 번째지? 다섯? 여섯?",
   "mood": "normal",
   "pause": 0.6,
   "sfx": [
    {
     "kind": "ding",
     "at": -0.5
    }
   ],
   "card": "c3"
  },
  {
   "who": "해설",
   "text": "이 종을 '인정'이라고 합니다.",
   "mood": "normal"
  },
  {
   "who": "해설",
   "text": "매일 밤 10시쯤, 종을 스물여덟 번 쳤습니다.",
   "mood": "normal"
  },
  {
   "who": "해설",
   "text": "그러면 성문을 닫고, 길을 다니는 걸 금지했지요.",
   "mood": "normal"
  },
  {
   "who": "해설",
   "text": "새벽 4시쯤엔 서른세 번을 쳐서 통행금지를 풀었습니다.",
   "mood": "normal",
   "card": "c4"
  },
  {
   "who": "해설",
   "text": "이건 '파루'라고 합니다.",
   "mood": "normal",
   "card": "c4"
  },
  {
   "who": "해설",
   "text": "1395년 도성을 쌓을 때부터, 성문 여덟 개가",
   "mood": "normal",
   "card": "c5"
  },
  {
   "who": "해설",
   "text": "이 종소리에 맞춰 열리고 닫혔지요.",
   "mood": "normal",
   "card": "c5"
  },
  {
   "who": "민재",
   "text": "그러니까 지금이 밤 10시고… 아침 4시까지 밖에 있으면 안 된다?",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "우리 때 편의점 알바 시간이랑 똑같네.",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "아니다, 그냥 집에 가자. 우리 집 마포니까 걸어서 한 시간.",
   "mood": "normal"
  },
  {
   "who": "민재",
   "text": "…어? 마포가 성 밖이네?",
