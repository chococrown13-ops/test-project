# 로컬 개발용 비밀값 예시. 이 파일을 복사해서 `.env`로 저장하고 값을 채우세요.
# `.env`는 .gitignore에 들어 있어야 하며, 절대 커밋·공유하지 않습니다.

# ── 한국투자증권(KIS) Open API ─────────────────────────
# 1) https://apiportal.koreainvestment.com 가입 → 마이페이지 → API 신청 → 앱 등록
#    (실전투자 계좌 기준으로 신청하세요. 모의투자만 쓰려면 KIS_ENV=demo)
# 2) 발급받은 앱키/앱시크릿을 아래에 채우기
KIS_APP_KEY=
KIS_APP_SECRET=
# 3) 계좌번호를 8자리 + 2자리로 나눠서 채우기 (예: 12345678-01)
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CD=01
# real: 실전투자 계좌(기본값) / demo: 모의투자 계좌
KIS_ENV=real
# 관심종목 조회 등에 필요한 HTS/MTS 로그인 아이디 (계좌번호 아님, 현재 kis.py는 미사용)
KIS_HTS_ID=
# 🔒 이 키로는 시세·랭킹 조회만 합니다 (data/sources/kis.py). 매수·매도 주문 API는 연결되어 있지 않습니다.

# ── OpenDART(전자공시시스템) Open API ────────────────────
# 1) https://opendart.fss.or.kr 가입 → 상단 "인증키 신청/관리" → 즉시 발급 (승인 대기 없음)
# 2) 발급받은 인증키를 아래에 채우기
DART_API_KEY=
# 🔒 재무제표 조회 전용입니다 (data/sources/dart.py). 선택 사항 — 비워두면 quality_score와
#    value_score(PEG 부분)가 0으로 처리된 채로 스크리닝이 동작합니다 (CLAUDE.md 참고).
